[Unit]
Description=Radar público: gera os agregados (depois da coleta das 05:30)
After=postgresql.service

[Service]
Type=oneshot
User=radar
Group=radar
ExecStart=/opt/radar-publico/venv/bin/python /opt/radar-publico/gerar.py
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/opt/radar-publico/site/data
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
OnFailure=homelab-alerta@%n.service
